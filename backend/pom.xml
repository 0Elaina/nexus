<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath />
    </parent>

    <groupId>com.nep</groupId>
    <artifactId>nexus-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>nexus-parent</name>
    <description>Nexus - 现代化博客系统 (聚合根父工程)</description>

    <!-- 1. 声明聚合子模块 (nexus 体系) -->
    <modules>
        <module>nexus-common</module>
        <module>nexus-category</module>
        <module>nexus-article</module>
        <module>nexus-user</module>
        <module>nexus-auth</module>
        <module>nexus-tag</module>
        <module>nexus-app</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <nexus.version>0.0.1-SNAPSHOT</nexus.version>
        <jjwt.version>0.12.6</jjwt.version>
    </properties>

    <!-- 2. 版本统一收口菜单 (子模块按需引用，无需手写版本号) -->
    <dependencyManagement>
        <dependencies>
            <!-- nexus 内部子模块声明 -->
            <dependency>
                <groupId>com.nep</groupId>
                <artifactId>nexus-common</artifactId>
                <version>${nexus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.nep</groupId>
                <artifactId>nexus-category</artifactId>
                <version>${nexus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.nep</groupId>
                <artifactId>nexus-article</artifactId>
                <version>${nexus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.nep</groupId>
                <artifactId>nexus-user</artifactId>
                <version>${nexus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.nep</groupId>
                <artifactId>nexus-auth</artifactId>
                <version>${nexus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.nep</groupId>
                <artifactId>nexus-tag</artifactId>
                <version>${nexus.version}</version>
            </dependency>

            <!-- JJWT 组件版本锁定 -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>

            <!-- MyBatis-Plus 相关组件版本锁定 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- 3. 所有子模块通用的全局依赖 (无条件自动继承) -->
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <!-- 4. 打包插件管理 (声明给子模块按需继承，根工程不直接打包) -->
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>